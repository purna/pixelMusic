{
  "schemaVersion": "1.0.0",

  "uiControls": {
    "knob": { "component": "Knob" },
    "slider": { "component": "Slider" },
    "select": { "component": "Select" },
    "toggle": { "component": "Toggle" },
    "pattern": { "component": "PatternInput" },
    "number": { "component": "NumberInput" },
    "childContainer": { "component": "ChildContainer" },
    "transformFunction": { "component": "TransformFunction" }
  },

  "transformNodes": {
    "chop": {
      "label": "Chop",
      "category": "rhythmic",
      "stage": "rhythmic",
      "wraps": false,
      "signature": "pattern.chop(slices)",
      "properties": {
        "slices": {
          "type": "number",
          "label": "Slices",
          "min": 1,
          "max": 16,
          "step": 1,
          "default": 8
        }
      },
      "examples": [
        "s('bd sd hh').chop(8)",
        "s('bd*4').chop(4)"
      ]
    },
    "crush": {
      "label": "Bit Crush",
      "category": "spectral",
      "stage": "spectral",
      "wraps": false,
      "signature": "pattern.crush(bits)",
      "properties": {
        "bits": {
          "type": "knob",
          "label": "Bit Depth",
          "min": 1,
          "max": 16,
          "default": 8
        }
      },
      "examples": [
        "s('bd sd').crush(4)",
        "note('c4 e4 g4').sound('piano').crush(2)"
      ]
    },
    "shape": {
      "label": "Wave Shape",
      "category": "spectral",
      "stage": "spectral",
      "wraps": false,
      "signature": "pattern.shape(amount)",
      "properties": {
        "amount": {
          "type": "knob",
          "label": "Shape Amount",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        }
      },
      "examples": [
        "s('bd').shape(0.8)",
        "note('c4').sound('sawtooth').shape(0.3)"
      ]
    },
    "vowel": {
      "label": "Vowel Filter",
      "category": "spectral",
      "stage": "spectral",
      "wraps": false,
      "signature": "pattern.vowel(vowelType)",
      "properties": {
        "vowel": {
          "type": "select",
          "label": "Vowel Type",
          "values": ["a", "e", "i", "o", "u"],
          "default": "a"
        }
      },
      "examples": [
        "s('bd').vowel('a')",
        "note('c4 e4 g4').sound('sawtooth').vowel('e')"
      ]
    },
    "jux": {
      "label": "Juxtapose",
      "category": "transform",
      "stage": "structural",
      "wraps": false,
      "signature": "pattern.jux(leftTransform, rightTransform)",
      "properties": {
        "leftTransform": {
          "type": "text",
          "label": "Left Channel Transform",
          "default": "x => x"
        },
        "rightTransform": {
          "type": "text",
          "label": "Right Channel Transform",
          "default": "x => x.pan(1)"
        }
      },
      "examples": [
        "s('bd sd').jux(x => x, x => x.pan(1))",
        "note('c4 e4 g4').sound('piano').jux(x => x.speed(2), x => x.slow(2))"
      ]
    },
    "rev": {
      "label": "Reverse",
      "category": "transform",
      "stage": "pitch",
      "wraps": false,
      "signature": "pattern.rev()",
      "properties": {},
      "examples": [
        "s('bd sd hh oh').rev()",
        "n('0 1 2 3').rev()"
      ]
    },
    "palindrome": {
      "label": "Palindrome",
      "category": "transform",
      "stage": "pitch",
      "wraps": false,
      "signature": "pattern.palindrome()",
      "properties": {},
      "examples": [
        "s('bd sd').palindrome()",
        "note('c4 e4 g4').sound('piano').palindrome()"
      ]
    },
    "shuffle": {
      "label": "Shuffle",
      "category": "transform",
      "stage": "pitch",
      "wraps": false,
      "signature": "pattern.shuffle(seed?)",
      "properties": {
        "seed": {
          "type": "number",
          "label": "Random Seed",
          "min": 0,
          "max": 1000,
          "default": 0
        }
      },
      "examples": [
        "s('bd sd hh oh').shuffle()",
        "note('c4 d4 e4 f4').sound('piano').shuffle(42)"
      ]
    },

    "stutter": {
      "label": "Stutter",
      "category": "rhythmic",
      "stage": "rhythmic",
      "signature": "pattern.stutter(repeats)",
      "properties": {
        "repeats": {
          "type": "number",
          "label": "Repeats",
          "min": 1,
          "max": 8,
          "step": 1,
          "default": 2
        }
      },
      "examples": [
        "s('bd').stutter(4)",
        "note('c4').sound('piano').stutter(2)"
      ]
    },

    "trunc": {
      "label": "Truncate",
      "category": "rhythmic",
      "stage": "rhythmic",
      "signature": "pattern.trunc(amount)",
      "properties": {
        "amount": {
          "type": "number",
          "label": "Tail Cut",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        }
      },
      "examples": [
        "s('bd sd hh oh').trunc(0.3)"
      ]
    },

    "speed": {
      "label": "Playback Speed",
      "category": "pitch",
      "stage": "pitch",
      "signature": "pattern.speed(factor)",
      "properties": {
        "factor": {
          "type": "number",
          "label": "Speed",
          "min": 0.1,
          "max": 2,
          "step": 0.01,
          "default": 1
        }
      },
      "examples": [
        "s('bd').speed(2)",
        "note('c4').sound('piano').speed(0.5)"
      ]
    },

    "note": {
      "label": "Pitch",
      "category": "pitch",
      "stage": "pitch",
      "signature": "pattern.note(semitones)",
      "properties": {
        "semitones": {
          "type": "number",
          "label": "Semitones",
          "min": -24,
          "max": 24,
          "step": 1,
          "default": 0
        }
      },
      "examples": [
        "note('c4').sound('piano').note(7) // transpose up a 5th",
        "s('bd').note(12) // drum pitch shift"
      ]
    },

    "coarse": {
      "label": "Octave Shift",
      "category": "pitch",
      "stage": "pitch",
      "signature": "pattern.coarse(octaves)",
      "properties": {
        "octaves": {
          "type": "number",
          "label": "Octaves",
          "min": -2,
          "max": 2,
          "step": 1,
          "default": 0
        }
      },
      "examples": [
        "note('c4').sound('piano').coarse(1) // up an octave",
        "note('c4').sound('piano').coarse(-1) // down an octave"
      ]
    },

    "vibrato": {
      "label": "Vibrato",
      "category": "modulation",
      "stage": "modulation",
      "signature": "pattern.vibrato(rate, depth?)",
      "properties": {
        "rate": {
          "type": "number",
          "label": "Rate (Hz)",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 4
        },
        "depth": {
          "type": "number",
          "label": "Depth",
          "min": 0,
          "max": 0.1,
          "step": 0.001,
          "default": 0.02
        }
      },
      "examples": [
        "note('c4').sound('sine').vibrato(5, 0.05)",
        "n('0 2 4 5').scale('C:major').sound('triangle').vibrato(8)"
      ]
    },

    "tremolo": {
      "label": "Tremolo",
      "category": "modulation",
      "stage": "modulation",
      "signature": "pattern.tremolo(rate, depth?)",
      "properties": {
        "rate": {
          "type": "number",
          "label": "Rate (Hz)",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 8
        },
        "depth": {
          "type": "number",
          "label": "Depth",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        }
      },
      "examples": [
        "note('c4').sound('sawtooth').tremolo(6, 0.8)",
        "s('bd sd hh').tremolo(10, 0.5)"
      ]
    },

    "lpf": {
      "label": "Low-Pass Filter",
      "category": "spectral",
      "stage": "spectral",
      "signature": "pattern.lpf(frequency)",
      "properties": {
        "frequency": {
          "type": "number",
          "label": "Cutoff (Hz)",
          "min": 20,
          "max": 20000,
          "step": 10,
          "default": 800
        }
      },
      "examples": [
        "s('bd sd hh').lpf(1000)",
        "note('c4 e4 g4').sound('sawtooth').lpf(2000).lpf(500)"
      ]
    },

    "hpf": {
      "label": "High-Pass Filter",
      "category": "spectral",
      "stage": "spectral",
      "signature": "pattern.hpf(frequency)",
      "properties": {
        "frequency": {
          "type": "number",
          "label": "Cutoff (Hz)",
          "min": 20,
          "max": 20000,
          "step": 10,
          "default": 200
        }
      },
      "examples": [
        "s('hh oh').hpf(200)",
        "note('c4').sound('piano').hpf(500)"
      ]
    },

    "lpq": {
      "label": "Filter Resonance",
      "category": "spectral",
      "stage": "spectral",
      "signature": "pattern.lpq(q)",
      "properties": {
        "q": {
          "type": "number",
          "label": "Resonance (Q)",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 0.7
        }
      },
      "examples": [
        "s('bd').lpf(800).lpq(5)",
        "note('c4').sound('sawtooth').lpf(1200).lpq(10)"
      ]
    },

    "gain": {
      "label": "Gain",
      "category": "spectral",
      "stage": "spectral",
      "signature": "pattern.gain(amount)",
      "properties": {
        "amount": {
          "type": "number",
          "label": "Volume",
          "min": 0,
          "max": 2,
          "step": 0.01,
          "default": 1
        }
      },
      "examples": [
        "s('bd sd').gain(0.8)",
        "note('c4 e4 g4').sound('piano').gain(1.2)"
      ]
    },

    "delay": {
      "label": "Delay",
      "category": "space",
      "stage": "space",
      "signature": "pattern.delay(time)",
      "properties": {
        "time": {
          "type": "number",
          "label": "Time (cycles)",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.25
        }
      },
      "examples": [
        "s('bd').delay(0.25)",
        "note('c4').sound('piano').delay(0.5)"
      ]
    },

    "delayfb": {
      "label": "Delay Feedback",
      "category": "space",
      "stage": "space",
      "signature": "pattern.delayfb(amount)",
      "properties": {
        "amount": {
          "type": "number",
          "label": "Feedback",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.4
        }
      },
      "examples": [
        "s('bd').delay(0.25).delayfb(0.5)",
        "note('c4').sound('piano').delay(0.3).delayfb(0.7)"
      ]
    },

    "reverb": {
      "label": "Reverb",
      "category": "space",
      "stage": "space",
      "signature": "pattern.reverb(amount)",
      "properties": {
        "amount": {
          "type": "number",
          "label": "Amount",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.3
        }
      },
      "examples": [
        "s('bd sd').reverb(0.3)",
        "note('c4 e4 g4').sound('piano').reverb(0.5)"
      ]
    },

    "room": {
      "label": "Room Size",
      "category": "space",
      "stage": "space",
      "signature": "pattern.room(size)",
      "properties": {
        "size": {
          "type": "number",
          "label": "Room Size",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        }
      },
      "examples": [
        "s('bd').room(0.5)",
        "note('c4').sound('piano').room(0.8)"
      ]
    },

    "often": {
      "label": "Often",
      "category": "probability",
      "stage": "wrapper",
      "wraps": true,
      "signature": "often(chance?)",
      "properties": {
        "chance": {
          "type": "number",
          "label": "Probability",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.75
        },
        "children": {
          "label": "Transform Functions",
          "type": "transformFunction",
          "description": "Functions to apply when condition is met",
          "minChildren": 1,
          "maxChildren": 4
        }
      },
      "examples": [
        "s('bd sd').often(0.8) // play often",
        "note('c4 e4 g4').sound('piano').often(0.6).speed(2)"
      ]
    },

    "sometimes": {
      "label": "Sometimes",
      "category": "probability",
      "stage": "wrapper",
      "wraps": true,
      "signature": "sometimes(chance?)",
      "properties": {
        "chance": {
          "type": "number",
          "label": "Probability",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.5
        }
      },
      "examples": [
        "s('bd sd hh').sometimes(0.5) // half the time",
        "note('c4 e4 g4').sound('piano').sometimes(0.3).fast(2)"
      ]
    },

    "rarely": {
      "label": "Rarely",
      "category": "probability",
      "stage": "wrapper",
      "wraps": true,
      "signature": "rarely(chance?)",
      "properties": {
        "chance": {
          "type": "number",
          "label": "Probability",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.25
        }
      },
      "examples": [
        "s('bd sd hh oh').rarely(0.1) // almost never",
        "note('c4').sound('piano').rarely(0.2).jux(x => x, x => x.pan(1))"
      ]
    }

  },

   "nodes": {
    "Instrument": {
      "title": "Instrument",
      "examples": [
        "s('piano')",
        "s('strings').gain(1.2).pan(-0.5)",
        "note('c4 e4 g4').sound('piano').note(7)"
      ],
      "sections": [
        {
          "id": "sound",
          "label": "Sound",
          "properties": {
            "sound": {
              "label": "Sample",
              "type": "select",
              "source": "instrumentList",
              "required": true,
              "mapsTo": "s"
            },
            "n": {
              "label": "Variant",
              "type": "number",
              "min": 0,
              "max": 255,
              "step": 1,
              "default": 0,
              "mapsTo": ".n"
            }
          }
        },
        {
          "id": "children",
          "label": "Child Patterns",
          "properties": {
            "children": {
              "label": "Child Container",
              "type": "childContainer",
              "description": "Drag patterns here to create parent-child relationships",
              "accepts": ["pattern", "transform"],
              "minChildren": 0,
              "maxChildren": 8
            }
          }
        },
        {
          "id": "mix",
          "label": "Mix",
          "properties": {
            "gain": {
              "label": "Gain",
              "type": "knob",
              "min": 0,
              "max": 2,
              "step": 0.01,
              "default": 1,
              "mapsTo": ".gain"
            },
            "pan": {
              "label": "Pan",
              "type": "slider",
              "min": -1,
              "max": 1,
              "step": 0.01,
              "default": 0,
              "mapsTo": ".pan"
            }
          }
        },
        {
          "id": "envelope",
          "label": "Envelope (ADSR)",
          "properties": {
            "attack": {
              "label": "Attack",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0.01,
              "mapsTo": ".attack"
            },
            "decay": {
              "label": "Decay",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0.3,
              "mapsTo": ".decay"
            },
            "sustain": {
              "label": "Sustain",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0.7,
              "mapsTo": ".sustain"
            },
            "release": {
              "label": "Release",
              "type": "knob",
              "min": 0,
              "max": 2,
              "step": 0.01,
              "default": 0.5,
              "mapsTo": ".release"
            }
          }
        },
        {
          "id": "effects",
          "label": "Audio Effects",
          "properties": {
            "vowel": {
              "label": "Vowel Filter",
              "type": "toggle",
              "default": false,
              "mapsTo": ".vowel"
            },
            "lpf": {
              "label": "Low Pass Filter",
              "type": "knob",
              "min": 50,
              "max": 8000,
              "step": 10,
              "default": 8000,
              "mapsTo": ".lpf"
            },
            "hpf": {
              "label": "High Pass Filter",
              "type": "knob",
              "min": 20,
              "max": 2000,
              "step": 10,
              "default": 20,
              "mapsTo": ".hpf"
            },
            "bpf": {
              "label": "Band Pass Filter",
              "type": "knob",
              "min": 100,
              "max": 4000,
              "step": 10,
              "default": 1000,
              "mapsTo": ".bpf"
            },
            "delay": {
              "label": "Delay",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0,
              "mapsTo": ".delay"
            },
            "reverb": {
              "label": "Reverb",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0,
              "mapsTo": ".reverb"
            },
            "distort": {
              "label": "Distortion",
              "type": "knob",
              "min": 0,
              "max": 1,
              "step": 0.01,
              "default": 0,
              "mapsTo": ".distort"
            },
            "crush": {
              "label": "Bit Crush",
              "type": "knob",
              "min": 0,
              "max": 16,
              "step": 1,
              "default": 0,
              "mapsTo": ".crush"
            },
            "speed": {
              "label": "Speed",
              "type": "knob",
              "min": 0.25,
              "max": 4,
              "step": 0.01,
              "default": 1,
              "mapsTo": ".speed"
            }
          }
        }
      ]
    },

    "DrumSymbol": {
      "title": "Drum",
      "sections": [
        {
          "id": "sound",
          "label": "Drum Sound",
          "properties": {
            "symbol": {
              "label": "Drum Type",
              "type": "select",
              "values": ["bd", "sd", "hh", "oh", "rim", "lt", "mt", "ht", "rd", "cr"],
              "mapsTo": "s"
            },
            "bank": {
              "label": "Drum Machine",
              "type": "select",
              "values": [
                "RolandTR909",
                "RolandTR808",
                "RolandTR707",
                "AkaiLinn",
                "RhythmAce",
                "ViscoSpaceDrum"
              ],
              "default": "RolandTR909",
              "mapsTo": ".bank"
            }
          }
        },
        {
          "id": "env",
          "label": "Envelope",
          "properties": {
            "dec": {
              "label": "Decay",
              "type": "knob",
              "min": 0,
              "max": 2,
              "step": 0.01,
              "default": 0.3,
              "mapsTo": ".dec"
            }
          }
        }
      ],
      "examples": [
        "s('bd sd hh oh')",
        "s('hh').bank('RolandTR909').dec(0.2)"
      ]
    },

    "Repeater": {
      "title": "Repeat",
      "signature": "*({amount})",
      "examples": [
        "s('bd sd hh')*4",
        "note('c4 e4 g4').sound('piano')*3"
      ],
      "sections": [
        {
          "id": "repeat",
          "label": "Repeat Settings",
          "properties": {
            "amount": {
              "label": "Repeats",
              "type": "number",
              "min": 1,
              "max": 32,
              "step": 1,
              "default": 4,
              "mapsTo": "*"
            }
          }
        }
      ]
    },

    "Generator": {
      "title": "Generator",
      "signature": "{type}({max})",
      "examples": [
        "irand(8)",
        "rand(0, 1)",
        "range(0, 10)"
      ],
      "sections": [
        {
          "id": "generator",
          "label": "Generator",
          "properties": {
            "type": {
              "label": "Generator Type",
              "type": "select",
              "values": ["irand", "rand", "range"],
              "mapsTo": "fn"
            },
            "max": {
              "label": "Max Value",
              "type": "number",
              "min": 1,
              "max": 512,
              "step": 1,
              "default": 8,
              "mapsTo": "arg"
            }
          }
        }
      ]
    },

    "Output": {
      "title": "Output",
      "sections": [
        {
          "id": "output",
          "label": "Output",
          "properties": {
            "enabled": {
              "label": "Enabled",
              "type": "toggle",
              "default": true,
              "mapsTo": "active"
            }
          }
        }
      ]
    }
  }
}
